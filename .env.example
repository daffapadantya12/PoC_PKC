# =============================================================================
# LiteLLM Configuration
# Supports 100+ LLM providers with unified API
# Docs: https://docs.litellm.ai/docs/providers
# =============================================================================

# Model to use (format depends on provider)
# Examples:
#   - gpt-4o-mini (OpenAI)
#   - claude-3-5-sonnet-20241022 (Anthropic)
#   - gemini/gemini-1.5-flash (Google)
#   - ollama/llama3.2 (Ollama local)
#   - ollama/gemma3:latest (Ollama local)
#   - groq/llama-3.1-70b-versatile (Groq)
#   - deepseek/deepseek-chat (DeepSeek)
#   - together_ai/meta-llama/Llama-3.1-70B-Instruct (Together AI)
LLM_MODEL=ollama/gemma3:latest

# API Base URL (optional, for custom endpoints)
# Examples:
#   - http://localhost:11434 (Ollama default)
#   - http://localhost:1234/v1 (LM Studio)
#   - https://api.openai.com/v1 (OpenAI)
#   - https://api.groq.com/openai/v1 (Groq)
LLM_API_BASE=http://localhost:11434

# API Keys (set based on your provider)
# OpenAI
# OPENAI_API_KEY=your_openai_api_key

# Anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key

# Google (Gemini)
# GEMINI_API_KEY=your_gemini_api_key

# Groq
# GROQ_API_KEY=your_groq_api_key

# Together AI
# TOGETHER_API_KEY=your_together_api_key

# DeepSeek
# DEEPSEEK_API_KEY=your_deepseek_api_key

# Ollama (local, no API key needed)
# Just make sure Ollama is running: ollama serve

# =============================================================================
# MinIO Object Storage (S3-compatible)
# =============================================================================
# Example values:
# MINIO_ENDPOINT=https://minio.pkc.pub/browser/pkc
# MINIO_BUCKET=pkc
# MINIO_ACCESS_KEY=your_access_key
# MINIO_SECRET_KEY=your_secret_key
# MINIO_SECURE=true
# MINIO_PUBLIC_BASE=https://minio.pkc.pub/pkc
# MINIO_PREFIX=downloads

# =============================================================================
# Whisper Configuration (faster-whisper)
# =============================================================================
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
